# Copy this file to .env and fill in real values.

# Port the server listens on (most hosts set this automatically).
PORT=3000

# Admin panel password. CHANGE THIS.
ADMIN_PASSWORD=change-this-strong-password

# Secret used to sign admin login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long an admin stays logged in.
TOKEN_TTL=8h

# Where the SQLite database file lives. On hosts with a persistent disk,
# point this at the mounted volume, e.g. /data/council.db
# DB_PATH=/data/council.db

# Restrict which origin may call the API (default "*" allows all).
# Set this if you host the front-end on a different domain than the API.
# CORS_ORIGIN=https://your-domain.com
