# Copy this file to .env (local) or set these as Environment Variables in Vercel.

# --- Database (required for the RBAC / competitions API) ---
# A Postgres connection string. Vercel Postgres, Neon, and Supabase all work.
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Auth ---
# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long a user stays logged in.
TOKEN_TTL=8h

# The first Admin account is created automatically on first run from these:
ADMIN_EMAIL=admin@ssac.local
ADMIN_PASSWORD=change-this-strong-password

# Restrict which origin may call the API (default "*"). Set if the front-end is
# on a different domain than the API.
# CORS_ORIGIN=https://your-domain.com

# --- Legacy Express server (server.js on Render), optional ---
PORT=3000
# DB_PATH=/data/council.db
